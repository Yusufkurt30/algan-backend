# PostgreSQL bağlantı URL'i (Render, Neon, Supabase, vb.)
DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT imzalama anahtarı – güçlü, rastgele bir string olmalı
# Örnek: openssl rand -base64 64
JWT_SECRET=your-very-strong-random-secret-here-change-this

# Token geçerlilik süresi (örn: 24h, 7d, 30m)
JWT_EXPIRES_IN=24h

# Uygulama portu (opsiyonel, default 3000)
PORT=3000
